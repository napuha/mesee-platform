# Copy to a local secret store; never commit real values.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me

# Video storage/processing provider (Mux or Cloudflare Stream)
VIDEO_PROVIDER=mux
VIDEO_PROVIDER_TOKEN=replace-me
VIDEO_SIGNING_KEY=replace-me

# Push notifications
FCM_PROJECT_ID=replace-me
FCM_SERVICE_ACCOUNT_JSON=replace-me

# Payments and creator payouts
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
PLATFORM_FEE_RATE=0.20

# App runtime
APP_ENV=development
ADMIN_EMAILS=admin@example.com
